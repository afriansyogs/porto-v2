# Copy to .env and fill in real values. Never commit .env (gitignored).

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Where contact-form messages arrive (your real inbox).
CONTACT_RECEIVER_EMAIL=you@example.com

# Verified Resend sender. For local dev with the test key,
# onboarding@resend.dev works out of the box.
CONTACT_SENDER_EMAIL=onboarding@resend.dev

# Absolute site URL for canonical/OG/sitemap/JSON-LD (no trailing slash).
# Also update the Sitemap: line in static/robots.txt to match.
PUBLIC_SITE_URL=https://your-domain.dev
